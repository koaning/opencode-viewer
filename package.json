{
  "name": "opencode-viewer",
  "version": "0.1.0",
  "description": "A live dashboard of the current OpenCode session: turns, time, context and tokens, in Desktop's side region",
  "license": "MIT",
  "keywords": ["opencode", "opencode-plugin", "dashboard", "tokens", "context"],
  "type": "module",
  "files": ["src", "dist"],
  "exports": {
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build",
    "screenshot": "bun scripts/screenshot/shoot.ts"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "playwright": "^1.65.1",
    "solid-js": "^1.9.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
